# ============================================================
# Hugging Face Spaces - Environment Variables (Secrets)
# Set all of these in your HF Space Settings > Variables and Secrets
# ============================================================

# --- Neon DB (PostgreSQL) ---
# Get from: https://console.neon.tech -> Connection string
# Must use the ?sslmode=require suffix
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>.neon.tech/<dbname>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon_username>
SPRING_DATASOURCE_PASSWORD=<neon_password>

# --- Upstash Redis ---
# Get from: https://console.upstash.com -> Your DB -> REST API -> rediss:// URL
# Use the rediss:// URL (with double s = SSL)
SPRING_REDIS_URL=rediss://:<password>@<host>.upstash.io:6379

# --- Cloudinary ---
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Google OAuth2 ---
# Get from: https://console.cloud.google.com -> APIs & Services -> Credentials
# Add your HF Space URL to Authorized redirect URIs:
#   https://<your-space>.hf.space/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Email (Gmail App Password) ---
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# --- App URLs ---
# Your Hugging Face Space backend URL
APP_API_URL=https://<your-hf-username>-<your-space-name>.hf.space
# Your deployed frontend URL (Vercel/Netlify/etc.)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# --- JWT Secret ---
# Generate a strong random 256-bit base64 secret. You can use:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here
